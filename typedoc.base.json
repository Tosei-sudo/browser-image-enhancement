{
  "$schema": "https://typedoc.org/schema.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": [
    "source-order"
  ],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "WorkerRequest",
    "WorkerResponse"
  ]
}
