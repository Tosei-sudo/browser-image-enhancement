{
  "name": "browser-image-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/workers",
    "packages/browser-image-enhancement",
    "packages/browser-image-geometry"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56",
    "eslint": "^10.11.0",
    "geotiff": "^3.1.0-beta.0",
    "ol": "^10.10.0",
    "proj4": "^2.22.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
