{
  "name": "browser-image-enhancement",
  "version": "0.1.0",
  "description": "Dependency-free image correction (brightness, contrast, exposure, gamma, saturation, temperature, levels) that runs in the browser, in Web Workers by default.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "image",
    "image-processing",
    "color-correction",
    "brightness",
    "contrast",
    "web-worker",
    "browser"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && npm run demo:build && npm run example:ol:build && vite build test/browser/bundled --outDir ../../../.bundled-test --emptyOutDir --base ./ && playwright test",
    "demo": "vite demo",
    "example:ol": "vite examples/openlayers-cog",
    "example:ol:build": "vite build examples/openlayers-cog --outDir ../../.example-dist/openlayers-cog --emptyOutDir --base ./",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:browser",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir --base ./",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56",
    "eslint": "^10.11.0",
    "geotiff": "^3.1.0-beta.0",
    "ol": "^10.10.0",
    "proj4": "^2.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tosei-sudo/browser-image-enhancement.git"
  },
  "engines": {
    "node": ">=20"
  }
}
