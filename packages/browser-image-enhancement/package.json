{
  "name": "browser-image-enhancement",
  "version": "0.1.0",
  "description": "Dependency-free image correction (brightness, contrast, exposure, gamma, saturation, temperature, tint, white balance, shadows, highlights, curves, levels, sharpening, automatic stretch / DRA) that runs in the browser, in Web Workers by default.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cdn/browser-image-enhancement.iife.min.js",
  "jsdelivr": "./dist/cdn/browser-image-enhancement.iife.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openlayers": {
      "types": "./dist/openlayers/index.d.ts",
      "import": "./dist/openlayers/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "image",
    "image-processing",
    "color-correction",
    "brightness",
    "contrast",
    "sharpen",
    "unsharp-mask",
    "histogram",
    "dynamic-range",
    "web-worker",
    "browser"
  ],
  "scripts": {
    "build": "tsdown && vite build -c cdn/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && npm run demo:build && npm run example:ol:build && vite build test/browser/bundled --outDir ../../../.bundled-test --emptyOutDir --base ./ && playwright test",
    "demo": "vite demo",
    "example:ol": "vite examples/openlayers-cog",
    "example:ol:build": "vite build examples/openlayers-cog --outDir ../../.example-dist/openlayers-cog --emptyOutDir --base ./",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir --base ./",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "ol": ">=10"
  },
  "peerDependenciesMeta": {
    "ol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@browser-image/workers": "0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tosei-sudo/browser-image-enhancement.git",
    "directory": "packages/browser-image-enhancement"
  },
  "engines": {
    "node": ">=20"
  }
}
