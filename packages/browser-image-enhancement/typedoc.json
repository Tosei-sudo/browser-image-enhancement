{
  "$schema": "https://typedoc.org/schema.json",
  "extends": [
    "../../typedoc.base.json"
  ],
  "entryPoints": [
    "src/index.ts",
    "src/openlayers/index.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "readme": "README.md",
  "excludeExternals": true,
  "intentionallyNotDocumented": [
    "index.RunResult.__type.output",
    "index.OpSpec.__type.op",
    "index.Pipeline.get.__type.op"
  ]
}
