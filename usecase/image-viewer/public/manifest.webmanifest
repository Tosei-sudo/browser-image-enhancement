{
  "name": "画像ビューア",
  "short_name": "画像ビューア",
  "description": "ローカルの画像・GeoTIFF・COG・ベクターを地図に重ね、ブラウザで補正するビューア",
  "lang": "ja",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b1d21",
  "theme_color": "#1e3a5f",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "protocol_handlers": [{ "protocol": "web+imageviewer", "url": "./?link=%s" }],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "handle_links": "preferred",
  "file_handlers": [
    {
      "action": "./",
      "name": "画像ビューアのプロジェクト",
      "accept": { "application/x-image-viewer-project+json": [".ivproj"] },
      "icons": [{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }],
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "name": "GeoTIFF・ベクター",
      "accept": {
        "image/tiff": [".tif", ".tiff"],
        "application/geo+json": [".geojson"],
        "application/geopackage+sqlite3": [".gpkg"]
      },
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "image/tiff",
            ".tif",
            ".tiff",
            "application/vnd.google-earth.kml+xml",
            ".kml",
            "application/vnd.google-earth.kmz",
            ".kmz",
            "application/gpx+xml",
            ".gpx",
            "application/geo+json",
            ".geojson",
            "application/json",
            "application/zip",
            ".zip",
            ".shp",
            ".dbf",
            ".shx",
            ".prj",
            "application/x-image-viewer-project+json",
            ".ivproj"
          ]
        }
      ]
    }
  }
}
