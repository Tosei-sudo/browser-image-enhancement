{
  "name": "@browser-image/usecase-image-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Image viewer site built on browser-image-enhancement: local files and COG URLs on an OpenLayers map, corrected in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir --base ./",
    "preview": "vite preview --base ./",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "vite build --emptyOutDir --base ./ && playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "browser-image-enhancement": "0.1.0",
    "browser-image-geometry": "0.1.0",
    "coordinate-notation": "0.1.0",
    "but-unzip": "^0.1.10",
    "d3-delaunay": "^6.0.4",
    "geographiclib-geodesic": "^2.2.0",
    "geotiff": "^3.1.0-beta.0",
    "jsts": "^2.12.1",
    "ol": "^10.10.0",
    "proj4": "^2.22.0",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4"
  }
}
